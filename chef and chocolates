import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt(); 

        while (T-- > 0) {
            int C = sc.nextInt(); 
            int X = sc.nextInt(); 
            int Y = sc.nextInt(); 

            int chocolatesToBuy = Math.max(0, C - X);
            int cost = chocolatesToBuy * Y;

            System.out.println(cost);
        }

        sc.close();
    }
}

