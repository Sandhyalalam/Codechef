import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		int t = sc.nextInt();
		
		while(t-->0)
		{
		    int n = sc.nextInt();
		    int last_digit = n%10;
		    int first_digit = n;
		      while (first_digit >= 10) {
                first_digit /= 10;
            }
                 int sum = first_digit + last_digit;
		                System.out.println(sum);
		}

	}
}
