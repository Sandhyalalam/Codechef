import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        
        while(T-- > 0){
            int X = sc.nextInt();
            int Y = sc.nextInt();
            int Z = sc.nextInt();
            
            int totalSeats = 10 * X;
            int booked = Math.min(totalSeats, Y);
            
            System.out.println(booked * Z);
        }
        sc.close();
    }
}
	
