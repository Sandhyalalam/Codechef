import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		int t = sc.nextInt();
		while(t-->0){
		    int c = sc.nextInt();
		    
		    if(c<=70)
		    {
		        System.out.println("0");
		    }
		    else if(c>70 && c<=100)
		    {
		        System.out.println("500");
		    }
		    else if(c>100)
		    {
		        System.out.println("2000");
		    }
		}

	}
}
