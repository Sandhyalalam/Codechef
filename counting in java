import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) 
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		while(n-->0){
		    
		    int x = sc.nextInt();
		    int y = sc.nextInt();
		    
		    int res = x*y;
		    
		    System.out.println(res);
		}

	}
}
